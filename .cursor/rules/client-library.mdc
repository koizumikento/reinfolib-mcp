## 使用例

### 基本的な使用方法

```python
import asyncio
from reinfolib_mcp import ReinfiolibClient

async def main():
    # APIキーを直接指定
    client = ReinfiolibClient(api_key="your_api_key")
    
    # または環境変数から取得
    # client = ReinfiolibClient()
    
    try:
        # 不動産取引価格検索
        result = await client.search_real_estate_transactions(
            prefecture="13",  # 東京都
            from_date="20230101",
            to_date="20231231"
        )
        
        print(f"検索結果: {result.total_count}件")
        for transaction in result.data[:5]:
            print(f"{transaction.city}: {transaction.price}円")
        
        # 市区町村一覧取得
        municipalities = await client.get_municipalities("13")
        print(f"東京都の市区町村数: {len(municipalities)}")
        
    except ReinfiolibAPIError as e:
        print(f"APIエラー: {e.message}")
    
    finally:
        await client.close()

if __name__ == "__main__":
    asyncio.run(main())
```

### コンテキストマネージャー対応

```python
class ReinfiolibClient:
    async def __aenter__(self):
        return self
    
    async def __aexit__(self, exc_type, exc_val, exc_tb):
        await self.close()
    
    async def close(self):
        """クライアントを閉じます"""
        await self._client.aclose()

# 使用例
async def main():
    async with ReinfiolibClient() as client:
        result = await client.search_real_estate_transactions(
            prefecture="13"
        )
        print(result.total_count)
```

## テスト設計

### モックテスト例

```python
import pytest
from unittest.mock import AsyncMock, patch
from reinfolib_mcp import ReinfiolibClient

@pytest.mark.asyncio
async def test_search_real_estate_transactions():
    with patch('httpx.AsyncClient') as mock_client:
        mock_response = AsyncMock()
        mock_response.json.return_value = {
            "data": [],
            "total_count": 0,
            "page": 1,
            "per_page": 100
        }
        mock_response.raise_for_status.return_value = None
        mock_client.return_value.get.return_value = mock_response
        
        client = ReinfiolibClient(api_key="test_key")
        result = await client.search_real_estate_transactions(prefecture="13")
        
        assert result.total_count == 0
        assert len(result.data) == 0
```
