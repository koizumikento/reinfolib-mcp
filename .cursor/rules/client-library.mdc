## エラーハンドリング

### カスタム例外定義

```python
class ReinfiolibAPIError(Exception):
    """不動産情報ライブラリAPI基底例外"""
    def __init__(self, message: str, status_code: Optional[int] = None):
        self.message = message
        self.status_code = status_code
        super().__init__(message)

class AuthenticationError(ReinfiolibAPIError):
    """認証エラー"""
    pass

class InvalidParameterError(ReinfiolibAPIError):
    """パラメータエラー"""
    pass

class RateLimitError(ReinfiolibAPIError):
    """レート制限エラー"""
    pass
```

### エラーハンドリング実装

```python
async def _handle_response(self, response: httpx.Response) -> Dict[str, Any]:
    """レスポンスのエラーハンドリング"""
    if response.status_code == 401:
        raise AuthenticationError("APIキーが無効です")
    elif response.status_code == 400:
        raise InvalidParameterError("リクエストパラメータが不正です")
    elif response.status_code == 429:
        raise RateLimitError("レート制限に達しました")
    elif response.status_code >= 400:
        raise ReinfiolibAPIError(
            f"APIエラー: {response.status_code}",
            response.status_code
        )
    
    return response.json()
```

