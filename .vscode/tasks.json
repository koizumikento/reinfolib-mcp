{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🧪 すべてのテストを実行",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "tests/",
        "-v"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$python"
    },
    {
      "label": "🧪 カバレッジ付きテスト実行",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "tests/",
        "--cov=src/reinfolib_mcp",
        "--cov-report=term-missing",
        "--cov-report=html"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": "$python"
    },
    {
      "label": "🧪 現在のファイルをテスト",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "${file}",
        "-v"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": "$python"
    },
    {
      "label": "🧪 失敗したテストのみ再実行",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "--lf",
        "-v"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": "$python"
    },
    {
      "label": "🔍 Ruff: 全体チェック",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "."
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.+?):(\\d+):(\\d+): (\\w+) (.+) \\[(.+)\\]$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5,
            "code": 6
          }
        ]
      }
    },
    {
      "label": "🔧 Ruff: 自動修正実行",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        ".",
        "--fix"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.+?):(\\d+):(\\d+): (\\w+) (.+) \\[(.+)\\]$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5,
            "code": 6
          }
        ]
      }
    },
    {
      "label": "🔧 Ruff: 現在のファイルをチェック",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "${file}"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.+?):(\\d+):(\\d+): (\\w+) (.+) \\[(.+)\\]$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5,
            "code": 6
          }
        ]
      }
    },
    {
      "label": "🔧 Ruff: 現在のファイルを自動修正",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "${file}",
        "--fix"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "🏗️ MyPy: 型チェック実行",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "mypy",
        "src/"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "mypy",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.+?):(\\d+): (error|warning|note): (.+)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        ]
      }
    },
    {
      "label": "📦 プロジェクトビルド",
      "type": "shell",
      "command": "uv",
      "args": [
        "build"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "🚀 MCPサーバー起動 (stdio)",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "reinfolib_mcp.cli"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "isBackground": true
    },
    {
      "label": "🚀 MCPサーバー起動 (HTTP)",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "reinfolib_mcp.cli",
        "--transport",
        "http",
        "--port",
        "8000"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "isBackground": true
    },
    {
      "label": "🔄 開発環境セットアップ",
      "type": "shell",
      "command": "uv",
      "args": [
        "sync",
        "--group",
        "dev"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}